# Copia este archivo como .env (solo para local). En Render se configuran en "Environment".
PORT=4000

# Vacío = guarda los datos en backend/data/db.json (modo local, sin base de datos).
# Con Supabase: Project Settings > Database > Connection string > "Session pooler" (puerto 5432)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Obligatorio en producción. Cadena larga y aleatoria.
JWT_SECRET=dev-secret-solo-para-local-cambiar
JWT_EXPIRES_IN=8h

# Orígenes permitidos (frontend). Separados por coma. Acepta comodín para previews: https://*.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Usuarios iniciales (solo se crean si no existe ningún usuario todavía)
SEED_ADMIN_EMAIL=admin@visionai.pe
SEED_ADMIN_PASSWORD=Admin#2026
SEED_SUPERVISOR_EMAIL=supervisor@visionai.pe
SEED_SUPERVISOR_PASSWORD=Supervisor#2026
SEED_OPERADOR_EMAIL=operador@visionai.pe
SEED_OPERADOR_PASSWORD=Operador#2026
SEED_AUDITOR_EMAIL=auditor@visionai.pe
SEED_AUDITOR_PASSWORD=Auditor#2026

# Servicio Python YOLO (ejecutar localmente en puerto 8000)
YOLO_SERVICE_URL=http://127.0.0.1:8000
